  "resources": {
    "xrp-hot-wallet": {
      "allow": [
        "transfer",
        "sign"
      ],
      "requires_grant": true,
      "destinations": [
        "xrp-cold-storage",
        "xrp-user-withdrawals"
      ],
      "approval_over": "$5m",
      "ceilings": [
        {
          "window": "10m",
          "max": "$10m"
        },
        {
          "window": "1h",
          "max": "$30m"
        }
      ],
      "freeze_for": "24h"
    },
